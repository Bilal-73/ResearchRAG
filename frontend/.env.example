# =============================================================================
# Research RAG — frontend environment template
#
#   1. Copy this file to `frontend/.env.local`.
#   2. Restart `npm run dev` after any change. Vite reads env files only at startup.
#   3. NEVER commit `.env.local`. It is git-ignored.
#
# WARNING: every VITE_* value is compiled into the JavaScript bundle and is
# readable by anyone who loads the site. Never put a production secret here.
# Full reference: docs/CONFIGURATION.md
# =============================================================================

# Where the FastAPI backend is listening.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Only needed if the backend has API_KEYS set in its own .env.
# Leave blank for local development (the API is open by default).
VITE_API_KEY=
