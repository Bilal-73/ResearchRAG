# ---- Azure OpenAI: embeddings (its own resource) ----
# Use the BASE resource URL only — no /openai/deployments/... path, no query string.
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<your-embedding-resource>.cognitiveservices.azure.com
AZURE_OPENAI_EMBEDDING_API_KEY=<your-embedding-resource-key>
AZURE_OPENAI_EMBEDDING_API_VERSION=2023-05-15
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# ---- Azure OpenAI: chat/generation (a DIFFERENT resource, that's fine) ----
AZURE_OPENAI_CHAT_ENDPOINT=https://<your-chat-resource>.openai.azure.com
AZURE_OPENAI_CHAT_API_KEY=<your-chat-resource-key>
AZURE_OPENAI_CHAT_API_VERSION=2025-01-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# ---- Qdrant ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=arxiv_papers

# ---- Corpus: Open RAG Benchmark (vectara/open_ragbench, arXiv split) ----
HF_DATASET_REPO=vectara/open_ragbench
HF_DATASET_SUBDIR=pdf/arxiv
OPEN_RAGBENCH_DIR=data/open_ragbench        # written by scripts/download_corpus.py
CORPUS_MANIFEST_PATH=data/arxiv_manifest.json   # written by scripts/run_ingestion.py

# ---- Ingestion ----
CHUNK_MAX_TOKENS=400                # text chunks packed up to this many tokens (cl100k_base)
CHUNK_OVERLAP_PARAGRAPHS=1          # paragraphs repeated between consecutive chunks
SKIP_REFERENCE_SECTIONS=true        # bibliographies add retrieval noise
CAPTION_FIGURES=false               # true = one VLM call per figure (slow); false = use the paper's own captions

# ---- Optional VLM, only used when CAPTION_FIGURES=true ----
# Default: self-hosted Qwen2.5-VL-7B via Ollama (`ollama pull qwen2.5vl:7b`).
# Any OpenAI-compatible vision endpoint works — .env values only, no code changes.
VLM_API_BASE=http://localhost:11434/v1
VLM_API_KEY=ollama
VLM_MODEL_NAME=qwen2.5vl:7b

# ---- Retrieval / generation knobs ----
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---- Advanced retrieval techniques (toggle independently; also per-request via the API) ----
ENABLE_QUERY_REWRITE=true
ENABLE_HYDE=true
ENABLE_RERANKER=true
ENABLE_PLANNER=true               # split multi-part questions into sub-questions, retrieve per part
MAX_SUB_QUESTIONS=3
ENABLE_CONTEXT_GRADING=true       # agent checks the evidence is enough; one corrective retry if not
ENABLE_GROUNDEDNESS_CHECK=true    # second LLM pass verifying every claim (adds ~1-2s per answer)
MAX_RETRIEVAL_RETRIES=1

# ---- Agent state & memory ----
MEMORY_MAX_TURNS=6                # turns kept verbatim; older ones are folded into a rolling summary
CHECKPOINT_BACKEND=memory         # memory | sqlite  (sqlite keeps conversations across restarts/workers)
CHECKPOINT_PATH=data/state/checkpoints.sqlite
CLASSIFIER_MIN_CONFIDENCE=0.5     # below this an intent falls back to "new_question" (the safe path)

# ---- Guardrails ----
PII_REDACTION_ENABLED=true
PII_BACKEND=regex                 # regex | presidio (presidio = names too; needs requirements-extras.txt)
INJECTION_GUARD_ENABLED=true
SELF_HARM_GUARD_ENABLED=true      # crisis-language short-circuit
HAZARD_GUARD_ENABLED=true         # declines procedural weapons/mass-harm requests (discussion stays allowed)
REFERENCE_CHECK_ENABLED=true      # strips arXiv ids / DOIs that aren't in the retrieved evidence
MAX_INPUT_CHARS=1500

# ---- Rate limiting (per API client: the API key, or the IP when unauthenticated) ----
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100
GLOBAL_RATE_LIMIT_PER_MINUTE=60   # all clients together (protects your Azure quota)
LLM_MAX_RETRIES=4                 # retries on Azure 429/5xx/timeouts, exponential backoff + jitter
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=60

# ---- HTTP API ----
# API_KEYS empty = NO AUTH. Fine locally; set it before exposing the API anywhere.
# /health reports which mode is live so an open deployment can't go unnoticed.
API_KEYS=
CORS_ORIGINS=*                    # comma-separated origins for a browser frontend, e.g. http://localhost:3000
TRUST_FORWARDED_FOR=false         # true ONLY behind a trusted proxy (otherwise clients can spoof their identity)

# ---- Logging ----
LOG_LEVEL=INFO                    # DEBUG for maximum verbosity

# ---- Redis cache (optional) ----
# Caches embeddings and VLM captions so re-running ingestion/evaluation after a code
# fix doesn't re-pay for unchanged content. If Redis isn't running this is silently
# skipped — nothing breaks, it's just slower. Start with: docker run -p 6379:6379 redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_ENABLED=true
